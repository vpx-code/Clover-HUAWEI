<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/bg_color">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/top_layout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.65"
            tools:ignore="ContentDescription" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.35"
            tools:ignore="ContentDescription" />
    </LinearLayout>

    <!--<com.github.matteobattilana.weather.WeatherView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />-->

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/action_bar_offset"
        android:background="?attr/toolbar"
        app:contentInsetStart="0dp"
        app:layout_constraintTop_toTopOf="parent">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:id="@+id/toolbar_text"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:fontFamily="@font/poppins_bold"
                android:text="@string/header_add"
                android:textSize="18sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!--<ImageButton
                android:id="@+id/help_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="16dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_baseline_help_outline_24" />-->
            <!--<TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:text="@string/app_name"
                android:fontFamily="@font/poppins_bold"
                android:textSize="42sp"
                android:textColor="@color/cardview_light_background"/>-->
        </RelativeLayout>
    </androidx.appcompat.widget.Toolbar>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:padding="16dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toTopOf="@id/btn_confirm" >
        <ScrollView
            android:id="@+id/scrollView2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/rounded_textview"
                    android:baselineAligned="false"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:padding="16dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:weightSum="1.0">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_weight="0.95" >
                        <TextView
                            android:id="@+id/text_name"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:text="@string/nombre"
                            android:textColor="@color/colorText"
                            android:textSize="@dimen/cloverText"
                            android:textStyle="bold" />
                        <EditText
                            android:id="@+id/et_nombre"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/cloverText"
                            android:inputType="textPersonName"
                            android:maxLength="20"
                            android:ellipsize="end"
                            android:importantForAutofill="no" />
                    </LinearLayout>
                    <ImageButton
                        android:id="@+id/btn_camera"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_weight="0.05"
                        android:background="@drawable/ic_baseline_filter_center_focus_24"
                        tools:ignore="ContentDescription" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/rounded_textview"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:id="@+id/text_pack"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="0.4"
                        android:gravity="center_vertical"
                        android:text="@string/tamano_blister"
                        android:textColor="@color/colorText"
                        android:textSize="@dimen/cloverText"
                        android:textStyle="bold"
                        app:drawableEndCompat="@drawable/ic_baseline_help_outline_24" />
                    <EditText
                        android:id="@+id/et_blister"
                        android:layout_width="@dimen/edittext_ems"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/cloverText"
                        android:inputType="number"
                        android:importantForAutofill="no" />
                </LinearLayout>



                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/rounded_textview"
                    android:orientation="vertical"
                    android:padding="16dp"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/text_fecha"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/fecha_de_inicio"
                        android:textColor="@color/colorText"
                        android:textSize="@dimen/cloverText"
                        android:textStyle="bold"
                        app:drawableEndCompat="@drawable/ic_baseline_help_outline_24" />

                    <DatePicker
                        android:id="@+id/datePicker"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/cloverText"
                        android:calendarViewShown="false"
                        android:datePickerMode="spinner" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/rounded_textview"
                    android:orientation="vertical"
                    android:padding="16dp">

                        <TextView
                            android:id="@+id/text_dosis"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="0.4"
                            android:gravity="center_vertical"
                            android:text="@string/tamano_dosis"
                            android:textColor="@color/colorText"
                            android:textSize="@dimen/cloverText"
                            android:textStyle="bold"
                            app:drawableEndCompat="@drawable/ic_baseline_help_outline_24" />

                        <EditText
                            android:id="@+id/et_dosis"
                            android:layout_width="@dimen/edittext_ems"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/cloverText"
                            android:inputType="number"
                            android:importantForAutofill="no"
                            android:layout_marginBottom="16dp"/>
                    <TextView
                        android:id="@+id/textFreq"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/frecuencia"
                        android:textColor="@color/colorText"
                        android:textSize="@dimen/cloverText"
                        android:textStyle="bold"
                        app:drawableEndCompat="@drawable/ic_baseline_help_outline_24" />

                    <RadioGroup
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checkedButton="@+id/optionA">

                        <RadioButton
                            android:id="@+id/optionA"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/cloverText"
                            android:onClick="onRadioButtonClicked"
                            android:text="@string/cada_dia" />

                        <RadioButton
                            android:id="@+id/optionB"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/cloverText"
                            android:onClick="onRadioButtonClicked"
                            android:text="@string/dias_especificos" />

                        <RadioButton
                            android:id="@+id/optionC"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/cloverText"
                            android:onClick="onRadioButtonClicked"
                            android:text="@string/intervalo_personalizado" />
                    </RadioGroup>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/dias_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/rounded_textview"
                    android:orientation="vertical"
                    android:padding="16dp"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/dias_especificos"
                        android:textColor="@color/colorText"
                        android:textSize="@dimen/cloverText"
                        android:textStyle="bold" />
                    <!-- Días de la semana. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:baselineAligned="false"
                        android:orientation="horizontal">
                        <!-- Lunes, miércoles, viernes y domingo. -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.5"
                            android:orientation="vertical">

                            <CheckBox
                                android:id="@+id/cb_lunes"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/cloverText"
                                android:text="@string/lunes" />

                            <CheckBox
                                android:id="@+id/cb_miercoles"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/cloverText"
                                android:text="@string/miercoles" />

                            <CheckBox
                                android:id="@+id/cb_viernes"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/cloverText"
                                android:text="@string/viernes" />

                            <CheckBox
                                android:id="@+id/cb_domingo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/cloverText"
                                android:text="@string/domingo" />
                        </LinearLayout>
                        <!-- Martes, jueves y sábado. -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.5"
                            android:orientation="vertical">

                            <CheckBox
                                android:id="@+id/cb_martes"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/cloverText"
                                android:text="@string/martes" />

                            <CheckBox
                                android:id="@+id/cb_jueves"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/cloverText"
                                android:text="@string/jueves" />

                            <CheckBox
                                android:id="@+id/cb_sabado"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/cloverText"
                                android:text="@string/sabado" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/interval_picker"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/rounded_textview"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/text_intervalo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/intervalo_personalizado"
                        android:textColor="@color/colorText"
                        android:textSize="@dimen/cloverText"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <NumberPicker
                            android:id="@+id/ipicker_num"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:textSize="@dimen/cloverText"
                            android:layout_weight="0.5" />

                        <NumberPicker
                            android:id="@+id/ipicker_dwm"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:textSize="@dimen/cloverText"
                            android:layout_weight="0.5" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <Button
        android:id="@+id/btn_confirm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/rounded_ok_button"
        android:text="@string/continuar"
        android:paddingVertical="@dimen/btn_padding"
        android:textColor="#FFFFFF"
        android:textSize="@dimen/btnText"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>